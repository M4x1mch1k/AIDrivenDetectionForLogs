# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AUDIT_TOPIC=audit-events
KAFKA_CONSUMER_GROUP=audit-middleware-mvp
KAFKA_AUTO_OFFSET_RESET=earliest

# OPA (base URL; deny paths are appended by OpaClient)
OPA_URL=http://localhost:8181
OPA_DENY_PATHS=/v1/data/aws/s3/compliance/deny,/v1/data/aws/iam_kms/compliance/deny

# Ollama (local only — no paid APIs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30
LLM_WINDOW_SIZE=5

# Persistence & producer
SQLITE_DB_PATH=./data/audit_mvp.db
PRODUCER_INTERVAL_SECONDS=2
